# ============================================================
# 青山利康 SRM 供应商智能助手 —— 环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，请勿提交真实密钥。
# ============================================================

# ---------- LLM（真·智能问答，强烈建议配置）----------
# DeepSeek（OpenAI 兼容）。配置后答案由大模型生成并带蓝图出处引用。
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 知识库 ----------
# 业务蓝图 docx 路径（绝对路径）
DOCX_PATH=D:/work/青山利康/蓝图或功能开发需求文档/青山利康SRM项目-业务蓝图V5.0.docx
KB_VERSION=V5.0

# ---------- 检索 / 嵌入 / 重排（生产默认：稠密向量 + pgvector + CrossEncoder 精排）----------
# 嵌入：bge（本地 BGE/M3E 稠密向量，生产首选）| api（OpenAI 兼容 Embedding API）| tfidf（本地开发兜底，勿用于生产）
EMBEDDING_PROVIDER=bge
# 本地稠密向量模型（HuggingFace 仓库名或本地路径）。常用：
#   BAAI/bge-small-zh-v1.5（512维，轻量）| BAAI/bge-large-zh-v1.5（1024维）| BAAI/bge-m3（多语言/多向量）
BGE_MODEL_PATH=BAAI/bge-small-zh-v1.5
# HuggingFace 镜像端点（国内拉取模型用，如 hf-mirror.com 或自建模型仓库）
HF_ENDPOINT=https://hf-mirror.com
# OpenAI 兼容 Embedding API（当 EMBEDDING_PROVIDER=api 时启用；国内常用硅基流动 BAAI/bge-m3、阿里百炼 text-embedding-v3、智谱 embedding-3）
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-m3

# 重排：bge（bge-reranker-v2-m3 CrossEncoder 精排，生产首选）| llm（大模型排序，回退）| identity（关闭）
RERANKER_PROVIDER=bge
RERANK_TOP_N=8

# 向量库：pgvector（生产默认）| numpy（本地零依赖）| chroma
VECTORSTORE_PROVIDER=pgvector
# PostgreSQL + pgvector 连接串（需先建库并启用 vector 扩展）
PGVECTOR_DSN=postgresql://srm:srm_pass@localhost:5432/srm
PGVECTOR_TABLE=srm_kb

# ---------- 安全 / 鉴权（生产务必修改）----------
# JWT 签名密钥：生成强随机值，例如 `openssl rand -hex 32`
JWT_SECRET=
# 服务级 API Key（供 SRM 后端 / iframe 直接调用，逗号分隔）
# 注意：默认值仅用于本地开发演示，生产必须替换为强随机值
API_KEYS=srm_dev_demo_key
# 默认管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
# CORS：生产改为 SRM 系统域名（逗号分隔），切勿保留 "*"
CORS_ORIGINS=*
# iframe 父域白名单（逗号分隔）；生产务必限定为 SRM 域名
IFRAME_ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MIN=60
